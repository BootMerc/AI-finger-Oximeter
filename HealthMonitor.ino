}
void updateStatusDisplay(bool finger, bool moving, bool ble) {
    tft.fillRect(40, 25, 160, 35, COLOR_BG);
    tft.fillCircle(80,  35, 5, finger ? COLOR_GREEN  : COLOR_GREY);
    tft.fillCircle(120, 35, 5, ble    ? COLOR_BLE_ON : COLOR_GREY);
    tft.fillCircle(160, 35, 5, moving ? COLOR_ORANGE : COLOR_GREEN);
    tft.setTextSize(1);
