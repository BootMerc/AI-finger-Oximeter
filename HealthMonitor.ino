// DISPLAY HELPERS
// setTextColor(fg, bg) fills each character's background pixel-by-pixel together
// with the foreground — no separate fillRect needed, so no black-flash before text.
void printCenteredText(String text, int y, int size, uint16_t color) {
    tft.setTextSize(size);
    tft.setTextColor(color, COLOR_BG);   // bg fill eliminates the clear→draw flash
    int16_t x1, y1;
    uint16_t w, h;
    tft.getTextBounds(text, 0, 0, &x1, &y1, &w, &h);
    tft.setCursor(120 - (w / 2), y);
    tft.print(text);
}
void updateHeartIcon(bool beat) {
    const int hx = 65, hy = 95;
    if (fingerDetected) {
        // Draw directly in the new colour — no fillRect beforehand.
        // Because the shape never changes, overwriting with a new colour is
        // instantaneous and removes the black-flash between every heartbeat.
        uint16_t color = beat ? COLOR_HEART : 0x2000;
        tft.fillCircle(hx - 4, hy,     4, color);
        tft.fillCircle(hx + 4, hy,     4, color);
        tft.fillTriangle(hx - 8, hy + 2, hx + 8, hy + 2, hx, hy + 10, color);
    } else {
        // Finger removed — only then clear the icon area
        tft.fillRect(hx - 10, hy - 10, 20, 20, COLOR_BG);
    }
}
